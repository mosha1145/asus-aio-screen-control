<?xml version="1.0" encoding="utf-8"?>
<!--
  v2 专用 NuGet 配置
  =====================================================================
  这里【只】声明包源，不指定 globalPackagesFolder。

  历史说明（避免再踩）：曾经硬编码 globalPackagesFolder = D:\Dev\NuGet\packages，
  换机器后该目录不存在，NuGet 会自动重建，看起来能跑，但把缓存放到了仓库所在盘
  的固定路径上，既不可移植也容易和环境变量 NUGET_PACKAGES 打架
  （环境变量优先级更高，两者不一致时会还原到意料之外的位置）。

  现在统一使用 NuGet 默认全局缓存：
      %USERPROFILE%\.nuget\packages
  如需自定义，请通过环境变量 NUGET_PACKAGES 统一设置，不要写进仓库文件。
  =====================================================================
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
