<?xml version="1.0" encoding="utf-8"?>
<!--
  v2 专用 NuGet 配置
  =====================================================================
  globalPackagesFolder 显式指向 NuGet 配置里约定的全局包目录
  （C:\Users\<user>\AppData\Roaming\NuGet\NuGet.Config 里也是这个值）。

  注意：环境变量 NUGET_PACKAGES 的优先级高于本文件的 globalPackagesFolder。
  本机曾把 NUGET_PACKAGES 设为 D:\dotnet\nuget\packages，导致包被还原到别处
  （并连带引发 WindowsAppRuntimeAutoInitializer.cpp 的 MSB8027 重复项警告）。
  该用户环境变量已一并修正为同一路径。二者现在一致。
  =====================================================================
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="D:\Dev\NuGet\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
