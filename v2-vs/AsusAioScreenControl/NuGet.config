<?xml version="1.0" encoding="utf-8"?>
<!--
  只声明包源；不指定 globalPackagesFolder（使用默认全局缓存
  %USERPROFILE%\.nuget\packages，保持可移植）。
  自定义缓存请用环境变量 NUGET_PACKAGES，不要写进仓库文件。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
